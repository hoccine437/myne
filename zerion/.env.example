# Copy to .env and replace placeholder values.
LLM_PROVIDER=gemini
# One key is shared by both chat (text) and voice (TTS). Do not add a
# separate VOICE_API_KEY; Zerion intentionally has one Gemini credential.
GEMINI_API_KEY=replace_with_key
GEMINI_MODEL=gemini-3-flash-lite
VOICE_ENABLED=true
VOICE_PROVIDER=gemini
VOICE_NAME=Charon
# Bounded x10 deliberation: ten reasoning lenses, larger evidence context,
# and deeper verified planning without ten extra API calls.
THINKING_MODE=x10
THINKING_MULTIPLIER=10
PLANNER_ENABLED=false
ENABLE_SELF_CRITIC=true
LOW_CONFIDENCE_THRESHOLD=0.45
MINIMUM_RESPONSE_LENGTH=3
MAXIMUM_IMPROVEMENT_ATTEMPTS=1
